    <meta name="keywords" content="Capri Club Westerholt, CCW, Ford Capri, Capri Treffen, Capri Club">

    <link rel="stylesheet" href="../css/home.css">
    <link rel="stylesheet" href="../css/lightbox.css">

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon"
          href="../images/favicon_set/favicon.ico">

    <link rel="icon"
          type="image/png"
          sizes="32x32"
          href="../images/favicon_set/favicon-32x32.png">

    <link rel="icon"
          type="image/png"
          sizes="16x16"
          href="../images/favicon_set/favicon-16x16.png">

    <link rel="apple-touch-icon"
          sizes="180x180"
          href="../images/favicon_set/apple-touch-icon.png">

    <link rel="manifest"
          href="../images/favicon_set/site.webmanifest">

    <meta name="theme-color" content="#000000">

