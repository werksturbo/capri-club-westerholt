          content="images/favicon_set/browserconfig.xml">

    <meta name="msapplication-config" content="/browserconfig.xml">

    <meta name="theme-color" content="#000000">


    <!-- =========================================================
         MOBILE NAVIGATION
         Bis 900px bleibt die Navigation auch im Querformat mobil.
         ========================================================= -->

    <style>

        .mobile-menu-toggle {
            display: none;
        }


        @media (max-width: 900px) {

            header {
                position: relative !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                min-height: 74px !important;
                height: auto !important;
                padding: 8px 14px !important;
                box-sizing: border-box !important;
            }


            header .logo {
                flex: 0 1 auto !important;
                min-width: 0 !important;
                margin: 0 auto !important;
                text-align: center !important;
            }


            header .logo img {
                display: block !important;
                width: auto !important;
                max-width: min(72vw, 300px) !important;
                max-height: 58px !important;
                margin: 0 !important;
            }


            /* Hamburger */

            .mobile-menu-toggle {
                position: absolute !important;
                left: 14px !important;
                top: 50% !important;
                transform: translateY(-50%) !important;

                width: 48px !important;
                height: 48px !important;

                margin: 0 !important;
                padding: 9px 8px !important;

                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 5px !important;

                border: 1px solid rgba(255,255,255,.35) !important;
                border-radius: 8px !important;

                background: rgba(255,255,255,.10) !important;
                color: inherit !important;

                cursor: pointer !important;

                box-sizing: border-box !important;

                z-index: 10001 !important;
            }


            .mobile-menu-toggle span {
                display: block !important;

                width: 25px !important;
                height: 3px !important;

                border-radius: 3px !important;

                background: currentColor !important;
            }


            /* =====================================================
               MOBILE NAVIGATION
               ===================================================== */

            header nav {
                display: none !important;

                position: absolute !important;

                z-index: 10000 !important;

                top: calc(100% - 1px) !important;

                left: 10px !important;
                right: 10px !important;

                width: auto !important;
                height: auto !important;

                max-height: calc(100vh - 90px) !important;

                overflow-y: auto !important;

                margin: 0 !important;
                padding: 6px 0 !important;

                border-radius: 0 0 10px 10px !important;

                box-sizing: border-box !important;

                background: #05019B !important;

                box-shadow: 0 8px 20px rgba(0,0,0,.28) !important;
            }


            header.nav-open nav {
                display: block !important;
            }


            header nav ul {
                display: flex !important;

                flex-direction: column !important;
                align-items: stretch !important;

                width: 100% !important;
                height: auto !important;

                margin: 0 !important;
                padding: 0 !important;

                list-style: none !important;

                gap: 0 !important;
            }


            header nav li {
                display: block !important;

                width: 100% !important;
                height: auto !important;

                margin: 0 !important;
                padding: 0 !important;
            }


            header nav li a {
                display: block !important;

                width: 100% !important;

                min-height: 45px !important;

                padding: 11px 18px !important;

                box-sizing: border-box !important;

                text-align: left !important;

                font-size: 17px !important;
                line-height: 1.3 !important;

                white-space: normal !important;

                border-radius: 0 !important;
            }


            /* Aktive Seite */

            header nav li a.active {
                background: rgba(255,255,255,.16) !important;
            }

        }


        /* =========================================================
           SEHR KLEINE SMARTPHONES
           ========================================================= */

        @media (max-width: 420px) {

            header {
                min-height: 66px !important;
                padding: 6px 10px !important;
            }


            header .logo img {
                max-width: 68vw !important;
                max-height: 52px !important;
            }


            .mobile-menu-toggle {
                left: 10px !important;

                width: 44px !important;
                height: 44px !important;
            }

        }


        /* =========================================================
           CCW NAVIGATION – Dropdown-Menüs
           ========================================================= */

        header nav ul {
            align-items: center;
        }

        header nav li {
            position: relative;
        }

        header nav li.has-submenu {
            display: flex;
            align-items: stretch;
        }

        .submenu-toggle {
            appearance: none;
            border: 0;
            margin: 0;
            padding: 12px 14px;
            background: transparent;
            color: white;
            font: inherit;
            font-weight: 600;
            font-size: 16px;
            line-height: 1.2;
            cursor: pointer;
            white-space: nowrap;
        }

        .submenu-toggle .arrow {
            display: inline-block;
            margin-left: 5px;
            font-size: 12px;
            transition: transform .18s ease;
        }

        .has-submenu.submenu-open .submenu-toggle .arrow {
            transform: rotate(180deg);
        }

        header nav ul.submenu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 10002;
            min-width: 220px;
            margin: 0;
            padding: 6px 0;
            list-style: none;
            background: #05019B;
            box-shadow: 0 8px 20px rgba(0,0,0,.28);
        }

        .has-submenu.submenu-open > ul.submenu {
            display: block;
        }

        header nav ul.submenu li {
            display: block;
            width: 100%;
        }

        header nav ul.submenu a {
            display: block;
            width: 100%;
            min-height: auto;
            padding: 10px 16px;
            box-sizing: border-box;
            text-align: left;
            white-space: normal;
            border-radius: 0;
        }

        /* Leere Dropdowns bleiben zunächst unsichtbar – sie dienen als
           Platzhalter, bis wir die echten Unterseiten übernehmen. */
        header nav ul.submenu:empty {
            display: none !important;
        }

        @media (max-width: 900px) {
            header nav ul {
                align-items: stretch;
            }

            header nav li.has-submenu {
                display: block;
            }

            .submenu-toggle {
                display: block;
                width: 100%;
                min-height: 45px;
                padding: 11px 18px;
                box-sizing: border-box;
                text-align: left;
                font-size: 17px;
                line-height: 1.3;
                white-space: normal;
            }

            header nav ul.submenu {
                position: static;
                min-width: 0;
                padding: 0;
                box-shadow: none;
                background: rgba(0,0,0,.12);
            }

            header nav ul.submenu a {
                padding: 10px 18px 10px 34px;
                font-size: 16px;
            }
        }

    </style>

<style>
/* ==========================================================
   WERBUNGSSEITE – CAPRI-ARCHIV DESIGN
   ========================================================== */

.werbung-page{
    padding:32px 0 50px;
}

.werbung-header{
    position:relative;
    background:linear-gradient(135deg, #ffffff 0%, #f9fbfd 100%);
    border:1px solid #dfe5ec;
    border-radius:14px;
    box-shadow:
        0 7px 18px rgba(0,0,0,.08),
        0 1px 3px rgba(0,0,0,.04);
    padding:24px 28px 20px;
    margin-bottom:28px;
    text-align:left;
    overflow:hidden;
}

.werbung-header::after{
    content:"CAPRI";
    position:absolute;
    right:24px;
    bottom:-18px;
    font-size:72px;
    line-height:1;
    font-weight:900;
    letter-spacing:5px;
    color:rgba(5,1,155,.035);
    pointer-events:none;
}

.werbung-header h1{
    position:relative;
    z-index:1;
    margin:0 0 5px;
    color:var(--primary);
    font-size:30px;
    line-height:1.2;
}

.werbung-header p{
    position:relative;
    z-index:1;
    margin:0;
    color:#5b6670;
    font-size:16px;
    line-height:1.5;
}

.werbung-bereich{
    background:rgba(255,255,255,.82);
    border:1px solid #dfe5ec;
    border-radius:14px;
    box-shadow:
        0 7px 18px rgba(0,0,0,.07),
        0 1px 3px rgba(0,0,0,.04);
    margin-bottom:28px;
    overflow:hidden;
}

.werbung-titel{
    position:relative;
    background:linear-gradient(135deg, #05019B 0%, #1514b5 58%, #1d7fc3 100%);
    color:var(--white);
    padding:13px 20px;
    box-shadow:0 2px 7px rgba(0,0,0,.12);
}

.werbung-titel::after{
    content:"";
    position:absolute;
    left:20px;
    right:20px;
    bottom:0;
    height:1px;
    background:rgba(255,255,255,.28);
}

.werbung-titel h2{
    margin:0;
    font-size:20px;
    line-height:1.3;
    font-weight:700;
}

.werbung-galerie{
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:18px;
    padding:20px;
    background:linear-gradient(to bottom, #f7f9fb 0%, #f2f5f8 100%);
}

.werbung-galerie.fuenf-spalten{
    grid-template-columns:repeat(5,minmax(0,1fr));
}

.werbung-thumbnail{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    aspect-ratio:143 / 75;
    overflow:hidden;
    border-radius:10px;
    background:#fffdf8;
    border:1px solid #d8e0e8;
    box-shadow:
        0 4px 10px rgba(0,0,0,.07),
        0 1px 2px rgba(0,0,0,.04);
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.werbung-thumbnail:hover{
    transform:translateY(-5px);
    border-color:rgba(5,1,155,.42);
    box-shadow:
        0 12px 24px rgba(0,0,0,.14),
        0 3px 7px rgba(5,1,155,.10);
}

.werbung-thumbnail::after{
    content:"↗";
    position:absolute;
    right:8px;
    bottom:8px;
    width:27px;
    height:27px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:rgba(255,255,255,.94);
    color:var(--primary);
    font-size:16px;
    font-weight:bold;
    box-shadow:0 2px 7px rgba(0,0,0,.16);
    opacity:0;
    transform:scale(.85);
    transition:opacity .2s ease, transform .2s ease;
}

.werbung-thumbnail:hover::after{
    opacity:1;
    transform:scale(1);
}

.werbung-thumbnail img{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    transition:transform .3s ease;
}

.werbung-thumbnail:hover img{
    transform:scale(1.035);
}

.werbung-platzhalter{
    min-height:230px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px dashed #aeb7c2;
    border-radius:10px;
    background:#f7f9fb;
    color:#6b7280;
    font-size:14px;
}

@media (max-width:1100px){
    .werbung-galerie,
    .werbung-galerie.fuenf-spalten{
        grid-template-columns:repeat(4,minmax(0,1fr));
    }
}

@media (max-width:900px){
    .werbung-galerie,
    .werbung-galerie.fuenf-spalten{
        grid-template-columns:repeat(3,minmax(0,1fr));
    }
}

@media (max-width:600px){
    .werbung-page{
        padding:20px 0 35px;
    }

    .werbung-header{
        padding:20px;
        margin-bottom:20px;
    }

    .werbung-header h1{
        font-size:26px;
    }

    .werbung-header::after{
        font-size:52px;
        right:12px;
        bottom:-10px;
    }

    .werbung-titel{
        padding:12px 15px;
    }

    .werbung-titel h2{
        font-size:18px;
    }

    .werbung-galerie,
    .werbung-galerie.fuenf-spalten{
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:12px;
        padding:14px;
    }

    .werbung-thumbnail{
        border-radius:8px;
    }

    .werbung-thumbnail::after{
        width:23px;
        height:23px;
        right:6px;
        bottom:6px;
        font-size:14px;
    }

    .werbung-platzhalter{
        min-height:180px;
    }
}
</style>

<style>
/* Aktiver Hauptmenüpunkt für den Bereich Capri Literatur */
.submenu-toggle.active{
    background:var(--white);
    color:var(--primary);
    padding:10px 18px;
    border-radius:6px;
    font-weight:bold;
}
</style>

